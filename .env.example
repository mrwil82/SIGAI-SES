# =============================================================================
# SIGAI-SES - Variables de Entorno (Raíz del proyecto para Docker Compose)
# =============================================================================
# INSTRUCCIONES:
# 1. Copia este archivo como .env en la raíz del proyecto
# 2. MODIFICA TODOS los valores marcados con "CAMBIAR_EN_PRODUCCION"
# 3. NUNCA subas este archivo a Git (ya está en .gitignore)
# 4. Para generar claves seguras, usa los comandos al final
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# BASE DE DATOS (MariaDB via Docker Compose)
# ─────────────────────────────────────────────────────────────────────────────
# Estos valores deben coincidir entre sí. Se usan para crear la BD y el usuario.
DB_ROOT_PASSWORD=CAMBIAR_EN_PRODUCCION_root_password_seguro_32_chars
DB_NAME=sigai_ses
DB_USER=sigai
DB_PASSWORD=CAMBIAR_EN_PRODUCCION_user_password_seguro_32_chars

# Puerto expuesto en el host (cambiar si 3306 está ocupado)
DB_PORT=3306

# ─────────────────────────────────────────────────────────────────────────────
# CLAVE SECRETA JWT - OBLIGATORIO CAMBIAR EN PRODUCCIÓN
# ─────────────────────────────────────────────────────────────────────────────
# Genera una NUEVA clave única para cada despliegue:
#   PowerShell:  -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })
#   Linux/Mac:   openssl rand -hex 32
#   Python:      python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CAMBIAR_EN_PRODUCCION_generar_clave_unica_64_chars_hex

# Algoritmo y expiración del token (no tocar salvo que sepas lo que haces)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─────────────────────────────────────────────────────────────────────────────
# CORS - ORÍGENES PERMITIDOS
# ─────────────────────────────────────────────────────────────────────────────
# LISTA DE DOMINIOS que pueden llamar al API (separados por coma, SIN espacios)
# En producción: poner el dominio REAL del frontend (ej: https://sigai.miempresa.com)
# En desarrollo local: http://localhost,http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80

# ─────────────────────────────────────────────────────────────────────────────
# USUARIO ADMINISTRADOR INICIAL
# ─────────────────────────────────────────────────────────────────────────────
# Se crea automáticamente al primer arranque si no existe.
# CAMBIA ESTAS CREDENCIALES INMEDIATAMENTE DESPUÉS DEL PRIMER LOGIN.
ADMIN_EMAIL=admin@suempresa.com
ADMIN_PASSWORD=CAMBIAR_EN_PRODUCCION_PasswordSeguro123!
ADMIN_NAME=Administrador SIGAI
ADMIN_CEDULA=0000000000
ADMIN_CODIGO=ADM001

# ─────────────────────────────────────────────────────────────────────────────
# CONFIGURACIÓN ADICIONAL BACKEND (opcional)
# ─────────────────────────────────────────────────────────────────────────────
# Workers de uvicorn (ajuste según CPU del servidor: 2-4 por core)
UVICORN_WORKERS=4

# Directorio de logs (dentro del contenedor mapea a ./logs en host)
LOG_DIR=/app/logs

# Zona horaria para logs y scheduler
TZ=America/Bogota

# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND (variables de build - se usan en npm run build)
# ─────────────────────────────────────────────────────────────────────────────
# URL pública del API (DEBE ser accesible desde el navegador del usuario)
# Ejemplos:
#   Local Docker:    http://localhost:8000
#   Dominio propio:  https://api.miempresa.com
#   Subpath:         https://miempresa.com/api
VITE_API_URL=http://localhost:8000

# Título de la aplicación (se muestra en browser tab)
VITE_APP_TITLE=SIGAI-SES

# ─────────────────────────────────────────────────────────────────────────────
# SSL / HTTPS (Opcional - para producción real con dominio propio)
# ─────────────────────────────────────────────────────────────────────────────
# Si usa Let's Encrypt o certificados propios, descomente y configure:
# SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
# SSL_KEY_PATH=/etc/nginx/ssl/key.pem
# FORCE_HTTPS=true

# ─────────────────────────────────────────────────────────────────────────────
# BACKUP AUTOMÁTICO (Opcional)
# ─────────────────────────────────────────────────────────────────────────────
# BACKUP_SCHEDULE=0 2 * * *  # Cron: cada día a las 2:00 AM
# BACKUP_RETENTION_DAYS=30
# BACKUP_PATH=/app/Backups

# =============================================================================
# CÓMO GENERAR VALORES SEGUROS (ejecute en terminal):
# =============================================================================
#
# 🔐 SECRET_KEY (JWT) - 64 caracteres hex:
#   PowerShell:  -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })
#   CMD:         python -c "import secrets; print(secrets.token_hex(32))"
#   Git Bash:    openssl rand -hex 32
#
# 🔐 DB_ROOT_PASSWORD / DB_PASSWORD - 32 caracteres hex:
#   PowerShell:  -join ((1..16) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })
#   CMD:         python -c "import secrets; print(secrets.token_hex(16))"
#   Git Bash:    openssl rand -hex 16
#
# 🔐 ADMIN_PASSWORD - Use un gestor de contraseñas o genere:
#   PowerShell:  "Admin$(Get-Random -Minimum 10000 -Maximum 99999)!"
#
# ⚠️  GUARDE ESTOS VALORES EN UN LUGAR SEGURO (gestor de contraseñas, vault).
#     No se pueden recuperar una vez perdidos.
# =============================================================================
