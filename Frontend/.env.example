# =============================================================================
# SIGAI-SES Frontend - Variables de Entorno
# =============================================================================
# INSTRUCCIONES PARA INGENIEROS:
#
# 1. Copia este archivo como .env en esta misma carpeta:
#    copy .env.example .env
#
# 2. Modifica la URL del backend según tu entorno.
#
# 3. Nunca subas el archivo .env a Git (ya está en .gitignore).
# =============================================================================

# --- URL del API Backend ---
# Descomenta UNA de las opciones según tu entorno:

# Desarrollo local (XAMPP + backend en localhost:8000)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Desarrollo local (Docker Compose - nginx en puerto 80)
# VITE_API_BASE_URL=http://localhost/api/v1

# Producción (Render/Railway)
# VITE_API_BASE_URL=https://sigai-ses-api.onrender.com/api/v1

# Producción (Dominio propio con subpath /api)
# VITE_API_BASE_URL=https://sigai.miempresa.com/api/v1

# Producción (Subdominio API separado)
# VITE_API_BASE_URL=https://api.miempresa.com/api/v1

# Supabase (si el backend usa Supabase directamente)
# VITE_API_BASE_URL=https://tu-backend.supabase.co/api/v1

# --- Configuración de la App (opcional) ---
# VITE_APP_TITLE=SIGAI-SES
# VITE_APP_VERSION=1.0.0
