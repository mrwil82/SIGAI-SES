# =============================================================================
# SIGAI-SES Backend - Variables de Entorno
# =============================================================================
# INSTRUCCIONES PARA INGENIEROS:
#
# 1. Copia este archivo como .env en esta misma carpeta:
#    copy .env.example .env
#
# 2. Modifica las variables segun tu entorno (ver abajo).
#
# 3. Nunca subas el archivo .env a Git (ya esta en .gitignore).
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# BASE DE DATOS
# ─────────────────────────────────────────────────────────────────────────────
# Opcion A: MySQL local (XAMPP) — para desarrollo
#   Requiere XAMPP corriendo con MySQL en puerto 3306.
#   Crear base de datos: CREATE DATABASE sigai_ses CHARACTER SET utf8mb4;
#
# Opcion B: PostgreSQL (produccion en Render)
#   La URL la obtienes del dashboard de Render > Environment.
#   Formato: postgresql+asyncpg://usuario:password@host:5432/database
#
# Opcion C: PostgreSQL local
#   Instala PostgreSQL y crea la base de datos sigai_ses.

# --- MySQL local (XAMPP) ---
DATABASE_URL=mysql+aiomysql://root:@localhost:3306/sigai_ses
DATABASE_URL_SYNC=mysql+pymysql://root:@localhost:3306/sigai_ses

# --- PostgreSQL (produccion) ---
# DATABASE_URL=postgresql+asyncpg://USUARIO:PASSWORD@HOST:5432/sigai_ses
# DATABASE_URL_SYNC=postgresql+psycopg2://USUARIO:PASSWORD@HOST:5432/sigai_ses

# ─────────────────────────────────────────────────────────────────────────────
# CLAVE SECRETA JWT
# ─────────────────────────────────────────────────────────────────────────────
# Genera una clave unica para produccion:
#   Python:  python -c "import secrets; print(secrets.token_hex(32))"
#   Linux:   openssl rand -hex 32
#
# En Render, configurala como variable secreta (Environment > Secret Files).

SECRET_KEY=cambiar-esta-clave-secreta-para-produccion

# ─────────────────────────────────────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────────────────────────────────────

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─────────────────────────────────────────────────────────────────────────────
# CORS — ORIGENES PERMITIDOS
# ─────────────────────────────────────────────────────────────────────────────
# Dominios que pueden acceder al API (separados por comas).
# En produccion incluye el dominio de Render.
# En desarrollo incluye localhost.

CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1,http://127.0.0.1:5173,https://sigai-ses-api.onrender.com,https://sigai-ses.onrender.com

# ─────────────────────────────────────────────────────────────────────────────
# USUARIO ADMINISTRADOR INICIAL
# ─────────────────────────────────────────────────────────────────────────────
# Se crea automaticamente en la primera ejecucion si no existe.
# CAMBIA estas credenciales en produccion.

ADMIN_EMAIL=admin@securitas.com
ADMIN_PASSWORD=CambiarEst3nProduccion!
ADMIN_NAME=Administrador SIGAI
ADMIN_CEDULA=0000000000
ADMIN_CODIGO=ADM001
