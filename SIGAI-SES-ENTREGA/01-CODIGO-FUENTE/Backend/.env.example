# =============================================================================
# SIGAI-SES Backend - Variables de Entorno
# =============================================================================
# INSTRUCCIONES PARA INGENIEROS:
#
# 1. Copia este archivo como .env en esta misma carpeta:
#    copy .env.example .env
#
# 2. Modifica las variables según tu entorno (ver abajo).
#
# 3. Nunca subas el archivo .env a Git (ya está en .gitignore).
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# BASE DE DATOS
# ─────────────────────────────────────────────────────────────────────────────
# Opción A: MySQL/MariaDB local (XAMPP) — para desarrollo
#   Requiere XAMPP corriendo con MySQL en puerto 3306.
#   Crear base de datos: CREATE DATABASE sigai_ses CHARACTER SET utf8mb4;
#
# Opción B: PostgreSQL (producción en Render/Railway/Supabase)
#   La URL la obtienes del dashboard del proveedor > Environment.
#   Formato: postgresql+asyncpg://usuario:password@host:5432/database
#
# Opción C: PostgreSQL local
#   Instala PostgreSQL y crea la base de datos sigai_ses.
#
# Opción D: Docker Compose (MariaDB en contenedor)
#   Usa las variables DB_* del .env raíz (docker-compose.yml)
#
# Opción E: Supabase (PostgreSQL en la nube - GRATIS 500MB)
#   Obtén la URL en Supabase > Project Settings > Database > Connection string
#   Usa "Session Pooler" (puerto 5432) para mejor rendimiento.
#   Formato:
#     DATABASE_URL=postgresql+asyncpg://postgres.XXXX:password@aws-0-us-west-2.pooler.supabase.com:5432/postgres
#     DATABASE_URL_SYNC=postgresql+psycopg2://postgres.XXXX:password@aws-0-us-west-2.pooler.supabase.com:5432/postgres

# --- MySQL/MariaDB local (XAMPP) ---
DATABASE_URL=mysql+aiomysql://root:@localhost:3306/sigai_ses
DATABASE_URL_SYNC=mysql+pymysql://root:@localhost:3306/sigai_ses

# --- PostgreSQL (producción Render/Railway/Supabase) ---
# DATABASE_URL=postgresql+asyncpg://USUARIO:PASSWORD@HOST:5432/sigai_ses
# DATABASE_URL_SYNC=postgresql+psycopg2://USUARIO:PASSWORD@HOST:5432/sigai_ses

# --- Supabase (PostgreSQL en la nube) ---
# DATABASE_URL=postgresql+asyncpg://postgres.XXXXXXXX:password@aws-0-us-west-2.pooler.supabase.com:5432/postgres
# DATABASE_URL_SYNC=postgresql+psycopg2://postgres.XXXXXXXX:password@aws-0-us-west-2.pooler.supabase.com:5432/postgres

# NOTA: DATABASE_URL_SYNC solo se usa para migraciones locales (Alembic).
# En Render/Railway solo necesitas DATABASE_URL (asíncrona).

# ─────────────────────────────────────────────────────────────────────────────
# CLAVE SECRETA JWT
# ─────────────────────────────────────────────────────────────────────────────
# Genera una clave única para producción:
#   Python:  python -c "import secrets; print(secrets.token_hex(32))"
#   Linux:   openssl rand -hex 32
#   PowerShell: -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })
#
# En Render/Railway, configúrala como variable secreta (Environment > Secret Files).

SECRET_KEY=cambiar-esta-clave-secreta-para-produccion

# ─────────────────────────────────────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────────────────────────────────────
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─────────────────────────────────────────────────────────────────────────────
# CORS — ORÍGENES PERMITIDOS
# ─────────────────────────────────────────────────────────────────────────────
# Dominios que pueden acceder al API (separados por comas, SIN espacios).
# En producción incluye el dominio del frontend.
# En desarrollo incluye localhost.

CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1,http://127.0.0.1:5173,http://localhost:80

# ─────────────────────────────────────────────────────────────────────────────
# USUARIO ADMINISTRADOR INICIAL
# ─────────────────────────────────────────────────────────────────────────────
# Se crea automáticamente en la primera ejecución si no existe.
# CAMBIA estas credenciales en producción.

ADMIN_EMAIL=admin@securitas.com
ADMIN_PASSWORD=CambiarEst3nProduccion!
ADMIN_NAME=Administrador SIGAI
ADMIN_CEDULA=0000000000
ADMIN_CODIGO=ADM001

# ─────────────────────────────────────────────────────────────────────────────
# CONFIGURACIÓN ADICIONAL (Opcional)
# ─────────────────────────────────────────────────────────────────────────────
# Workers de uvicorn (para Docker/producción)
# UVICORN_WORKERS=4

# Directorio de logs
# LOG_DIR=/app/logs

# Zona horaria
# TZ=America/Bogota
