# --- URL del API Backend ---
# Descomenta UNA de las opciones segun tu entorno:

# Desarrollo local (XAMPP + backend en localhost:8000)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Produccion (Render)
# VITE_API_BASE_URL=https://sigai-ses-api.onrender.com/api/v1
