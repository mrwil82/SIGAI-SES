# =============================================================================
# SIGAI-SES Frontend - Dockerfile para Desarrollo (Hot Reload)
# =============================================================================
# Uso: docker build -f Dockerfile.dev -t sigai-frontend-dev .
# =============================================================================

FROM node:20-alpine

WORKDIR /app

# Instalar dependencias del sistema para Vite
RUN apk add --no-cache bash

# Copiar package.json e instalar dependencias
COPY package.json package-lock.json* ./
RUN npm install

# Exponer puerto de Vite
EXPOSE 5173

# Comando por defecto (sobrescrito en docker-compose.override.yml)
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
